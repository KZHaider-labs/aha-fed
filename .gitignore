*.py[cod]
*.egg-info/
.venv/
venv/
.env

# IDE
.idea/
.vscode/
*.ipynb_checkpoints/

# Data and models (never commit)
data/raw/
data/processed/
data/cache/
datasets/
checkpoints/
models/saved/
*.pth
*.pt
*.ckpt
*.h5
*.npz

# Experiment results
results/
# runs/ holds the JSON artifact for every experiment in the paper.
# paper/verify_claims.py re-checks the paper against these, so they are
# tracked (~3 MB). Large outputs stay ignored below.
!runs/
runs/**/*.png
runs/**/*.pth
wandb/
mlruns/
outputs/
multirun/
*.log

# Thesis build artifacts
thesis/main.pdf
thesis/*.aux
thesis/*.bbl
thesis/*.blg
thesis/*.log
thesis/*.out
thesis/*.toc
thesis/*.fls
thesis/*.fdb_latexmk
thesis/*.synctex.gz

# Paper / research writeup (kept out of the public code repo).
# Anchored so it does not also match runs/paper/, which holds the run
# artifacts the paper is verified against.
/paper/
PROPOSAL.md

# OS
.DS_Store
Thumbs.db
